{
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "destination": "/api/compartir"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "presupuesto"
        }
      ],
      "destination": "/api/compartir"
    },
    {
      "source": "/precios",
      "has": [
        {
          "type": "query",
          "key": "p"
        }
      ],
      "destination": "/api/compartir"
    },
    {
      "source": "/precios",
      "has": [
        {
          "type": "query",
          "key": "presupuesto"
        }
      ],
      "destination": "/api/compartir"
    },
    {
      "source": "/",
      "destination": "/precios.html"
    },
    {
      "source": "/precios",
      "destination": "/precios.html"
    },
    {
      "source": "/login",
      "destination": "/crm.html"
    },
    {
      "source": "/api/bandeja/:path*",
      "destination": "/api/bandeja"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://script.google.com https://api.bluelytics.com.ar https://dolarapi.com; frame-src 'self' https://accounts.google.com https://www.google.com; object-src 'none';"
        }
      ]
    },
    {
      "source": "/crm.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/login",
      "permanent": false
    }
  ]
}
